---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- BBQ grill with fire and smoke -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Smoke wisps -->
  <path d="M22 8 Q20 5 22 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.35"/>
  <path d="M32 6 Q30 3 32 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.35"/>
  <path d="M42 8 Q40 5 42 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.35"/>
  <!-- Grill dome lid -->
  <path d="M10 30 Q10 12 32 12 Q54 12 54 30 Z" fill="currentColor" opacity="0.2" stroke="currentColor" stroke-width="2"/>
  <!-- Lid handle -->
  <rect x="28" y="10" width="8" height="4" rx="2" fill="currentColor" opacity="0.7"/>
  <!-- Grill rim -->
  <rect x="8" y="28" width="48" height="5" rx="2.5" fill="currentColor" opacity="0.5"/>
  <!-- Grill grates -->
  <line x1="16" y1="20" x2="16" y2="28" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
  <line x1="22" y1="16" x2="22" y2="28" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
  <line x1="28" y1="14" x2="28" y2="28" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
  <line x1="34" y1="14" x2="34" y2="28" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
  <line x1="40" y1="16" x2="40" y2="28" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
  <line x1="46" y1="20" x2="46" y2="28" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
  <!-- Bowl lower half -->
  <path d="M8 33 Q10 44 32 44 Q54 44 56 33 Z" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/>
  <!-- Flame inside -->
  <path d="M26 42 Q24 36 28 33 Q29 38 32 35 Q35 32 34 38 Q38 34 37 40 Q40 37 38 42 Q35 44 32 43 Q29 44 26 42Z" fill="currentColor" opacity="0.6"/>
  <!-- Legs -->
  <line x1="20" y1="44" x2="14" y2="60" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="44" y1="44" x2="50" y2="60" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <!-- Cross bar -->
  <line x1="16" y1="54" x2="48" y2="54" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>
  <!-- Hook for tools -->
  <circle cx="32" cy="54" r="2" fill="currentColor" opacity="0.5"/>
</svg>
