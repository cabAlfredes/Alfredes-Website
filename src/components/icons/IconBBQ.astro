---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Kettle grill with herb sprig and playful flame -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Smoke wisps -->
  <path d="M24 10 Q22 7 24 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
  <path d="M32 8 Q30 5 32 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
  <path d="M40 10 Q38 7 40 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
  <!-- Dome lid -->
  <path d="M10 30 Q10 12 32 12 Q54 12 54 30 Z" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/>
  <!-- Lid handle -->
  <rect x="28" y="9" width="8" height="4" rx="2" fill="currentColor" opacity="0.6"/>
  <!-- Herb sprig on handle (rosemary vibes) -->
  <path d="M38 10 Q42 5 46 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.7"/>
  <ellipse cx="43" cy="6" rx="2.5" ry="1.3" fill="currentColor" opacity="0.5" transform="rotate(-35 43 6)"/>
  <ellipse cx="46" cy="8" rx="2" ry="1.2" fill="currentColor" opacity="0.4" transform="rotate(10 46 8)"/>
  <!-- Grill rim -->
  <rect x="8" y="28" width="48" height="5" rx="2.5" fill="currentColor" opacity="0.4"/>
  <!-- Bowl lower half -->
  <path d="M8 33 Q10 46 32 46 Q54 46 56 33 Z" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="2"/>
  <!-- Playful rounded flame -->
  <path d="M25 44 Q22 37 27 33 Q29 39 32 35 Q35 31 35 38 Q38 34 38 43 Q35 47 32 46 Q29 47 25 44Z" fill="currentColor" opacity="0.65"/>
  <!-- Legs -->
  <line x1="20" y1="46" x2="13" y2="60" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="44" y1="46" x2="51" y2="60" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <!-- Crossbar -->
  <line x1="15" y1="54" x2="49" y2="54" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
</svg>
