---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Equipped kitchen: pot on stove with steam -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Steam wisps -->
  <path d="M22 12 Q20 9 22 6 Q24 3 22 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.45"/>
  <path d="M32 10 Q30 7 32 4 Q34 1 32 -2" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.45"/>
  <path d="M42 12 Q40 9 42 6 Q44 3 42 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.45"/>
  <!-- Pot lid -->
  <ellipse cx="32" cy="19" rx="14" ry="3.5" fill="currentColor" opacity="0.7"/>
  <rect x="29" y="15" width="6" height="4" rx="1" fill="currentColor" opacity="0.9"/>
  <!-- Pot body -->
  <path d="M18 21 Q18 38 32 38 Q46 38 46 21 Z" fill="currentColor" opacity="0.2" stroke="currentColor" stroke-width="2"/>
  <path d="M18 21 L46 21" stroke="currentColor" stroke-width="2"/>
  <!-- Pot handles -->
  <path d="M18 24 Q12 24 12 28 Q12 32 18 32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  <path d="M46 24 Q52 24 52 28 Q52 32 46 32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  <!-- Stove top surface -->
  <rect x="6" y="38" width="52" height="6" rx="2" fill="currentColor" opacity="0.2" stroke="currentColor" stroke-width="1.5"/>
  <!-- Burner rings -->
  <circle cx="32" cy="41" r="5" stroke="currentColor" stroke-width="1.5" opacity="0.5" fill="none"/>
  <circle cx="32" cy="41" r="2.5" stroke="currentColor" stroke-width="1" opacity="0.4" fill="none"/>
  <!-- Stove knobs -->
  <circle cx="14" cy="50" r="3" fill="currentColor" opacity="0.5"/>
  <circle cx="24" cy="50" r="3" fill="currentColor" opacity="0.5"/>
  <circle cx="40" cy="50" r="3" fill="currentColor" opacity="0.5"/>
  <circle cx="50" cy="50" r="3" fill="currentColor" opacity="0.5"/>
  <!-- Stove front panel -->
  <rect x="6" y="44" width="52" height="14" rx="2" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1.5"/>
</svg>
