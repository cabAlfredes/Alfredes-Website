---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Person watching video on a laptop = internet/WiFi -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Laptop base -->
  <rect x="10" y="34" width="44" height="2.5" rx="1.5" fill="currentColor" opacity="0.3"/>
  <!-- Laptop body -->
  <rect x="14" y="16" width="36" height="24" rx="2.5" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/>
  <!-- Screen bezel inner -->
  <rect x="17" y="19" width="30" height="18" rx="1.5" fill="currentColor" opacity="0.12"/>
  <!-- Play button on screen -->
  <path d="M28 24 L28 34 L37 29 Z" fill="currentColor" opacity="0.75"/>
  <!-- Progress bar -->
  <rect x="19" y="35.5" width="18" height="1.5" rx="0.75" fill="currentColor" opacity="0.6"/>
  <rect x="19" y="35.5" width="7" height="1.5" rx="0.75" fill="currentColor" opacity="1"/>
  <!-- Person sitting silhouette -->
  <!-- Head -->
  <circle cx="32" cy="9" r="4" fill="currentColor" opacity="0.85"/>
  <!-- Body / shoulders -->
  <path d="M25 14 Q32 11 39 14 L38 16 Q32 13.5 26 16 Z" fill="currentColor" opacity="0.85"/>
  <!-- WiFi arc small above head -->
  <path d="M26 5 Q32 1 38 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5"/>
  <path d="M28.5 3 Q32 1 35.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.8"/>
  <circle cx="32" cy="2" r="1.2" fill="currentColor" opacity="0.9"/>
</svg>
