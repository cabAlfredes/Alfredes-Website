---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Little bird on a branch "broadcasting" WiFi -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- WiFi arcs (from bird's head area) -->
  <path d="M14 28 Q32 10 50 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.25"/>
  <path d="M19 34 Q32 18 45 34" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.55"/>
  <path d="M24 40 Q32 28 40 40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  <!-- WiFi dot = bird's head area -->
  <!-- Bird body -->
  <ellipse cx="29" cy="52" rx="9" ry="6" fill="currentColor" opacity="0.8"/>
  <!-- Bird head -->
  <circle cx="36" cy="46" r="5.5" fill="currentColor" opacity="0.85"/>
  <!-- Beak (open, broadcasting!) -->
  <path d="M41 44.5 L47 46 L41 47.5 Z" fill="currentColor" opacity="0.9"/>
  <!-- Eye -->
  <circle cx="37.5" cy="45" r="1.4" fill="white" opacity="0.9"/>
  <circle cx="37.8" cy="45" r="0.6" fill="currentColor" opacity="0.9"/>
  <!-- Wing detail -->
  <path d="M21 51 Q18 56 22 58 Q24 53 21 51Z" fill="currentColor" opacity="0.6"/>
  <!-- Tail feathers -->
  <path d="M21 53 Q14 56 16 60" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
  <!-- Branch -->
  <path d="M4 58 Q20 55 40 58 Q50 60 60 56" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="0.5"/>
  <!-- Small leaf on branch -->
  <path d="M50 56 Q55 50 58 52 Q55 56 50 56Z" fill="currentColor" opacity="0.4"/>
  <!-- Feet on branch -->
  <line x1="28" y1="57" x2="26" y2="60" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
  <line x1="32" y1="57" x2="34" y2="60" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
</svg>
