---
interface Props {
	class?: string;
}
const { class: cls = "" } = Astro.props;
---
<!-- Cozy bed with a tiny bird peeking through the window -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Window -->
  <rect x="21" y="4" width="22" height="16" rx="2" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1.5"/>
  <!-- Window cross -->
  <line x1="32" y1="4" x2="32" y2="20" stroke="currentColor" stroke-width="1" opacity="0.35"/>
  <line x1="21" y1="12" x2="43" y2="12" stroke="currentColor" stroke-width="1" opacity="0.35"/>
  <!-- Tiny bird in upper-left pane -->
  <ellipse cx="26" cy="8" rx="3" ry="2" fill="currentColor" opacity="0.7"/>
  <circle cx="28.5" cy="7" r="2" fill="currentColor" opacity="0.7"/>
  <path d="M30 6.5 L33 7 L30 7.5 Z" fill="currentColor" opacity="0.7"/>
  <circle cx="29.5" cy="6.8" r="0.8" fill="white" opacity="0.8"/>
  <!-- Headboard -->
  <rect x="8" y="26" width="48" height="6" rx="3" fill="currentColor" opacity="0.55"/>
  <!-- Bed frame -->
  <rect x="8" y="30" width="48" height="22" rx="2" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="2"/>
  <!-- Blanket -->
  <rect x="10" y="32" width="44" height="18" rx="2" fill="currentColor" opacity="0.18"/>
  <!-- Left pillow -->
  <rect x="13" y="33" width="17" height="9" rx="3" fill="currentColor" opacity="0.55"/>
  <!-- Right pillow -->
  <rect x="34" y="33" width="17" height="9" rx="3" fill="currentColor" opacity="0.55"/>
  <!-- Blanket fold -->
  <path d="M10 44 Q32 47 54 44" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.35"/>
  <!-- Legs -->
  <rect x="10" y="52" width="4" height="8" rx="2" fill="currentColor" opacity="0.45"/>
  <rect x="50" y="52" width="4" height="8" rx="2" fill="currentColor" opacity="0.45"/>
</svg>
