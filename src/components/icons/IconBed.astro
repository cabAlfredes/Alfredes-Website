---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Double bed with river view window -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Window with river view -->
  <rect x="20" y="4" width="24" height="18" rx="2" fill="currentColor" opacity="0.12" stroke="currentColor" stroke-width="1.5"/>
  <!-- Window cross -->
  <line x1="32" y1="4" x2="32" y2="22" stroke="currentColor" stroke-width="1" opacity="0.4"/>
  <line x1="20" y1="13" x2="44" y2="13" stroke="currentColor" stroke-width="1" opacity="0.4"/>
  <!-- Water ripple in window -->
  <path d="M22 17 Q27 15 32 17 Q37 19 42 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.6"/>
  <!-- Headboard -->
  <rect x="8" y="26" width="48" height="6" rx="3" fill="currentColor" opacity="0.55"/>
  <!-- Bed frame -->
  <rect x="8" y="30" width="48" height="22" rx="2" fill="currentColor" opacity="0.12" stroke="currentColor" stroke-width="2"/>
  <!-- Mattress / blanket -->
  <rect x="10" y="32" width="44" height="18" rx="2" fill="currentColor" opacity="0.2"/>
  <!-- Left pillow -->
  <rect x="13" y="33" width="17" height="9" rx="3" fill="currentColor" opacity="0.6"/>
  <!-- Right pillow -->
  <rect x="34" y="33" width="17" height="9" rx="3" fill="currentColor" opacity="0.6"/>
  <!-- Blanket fold line -->
  <path d="M10 44 Q32 47 54 44" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.4"/>
  <!-- Bed legs -->
  <rect x="10" y="52" width="4" height="8" rx="2" fill="currentColor" opacity="0.5"/>
  <rect x="50" y="52" width="4" height="8" rx="2" fill="currentColor" opacity="0.5"/>
</svg>
