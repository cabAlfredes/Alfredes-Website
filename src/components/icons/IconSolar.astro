---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Solar panels with sun -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Sun -->
  <circle cx="32" cy="14" r="7" fill="currentColor" opacity="0.85"/>
  <!-- Sun rays -->
  <line x1="32" y1="4" x2="32" y2="1" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="43" y1="7" x2="45" y2="5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="47" y1="14" x2="50" y2="14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="43" y1="21" x2="45" y2="23" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="21" y1="7" x2="19" y2="5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="17" y1="14" x2="14" y2="14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="21" y1="21" x2="19" y2="23" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <!-- Solar panel left -->
  <rect x="8" y="34" width="22" height="16" rx="2" fill="currentColor" opacity="0.2" stroke="currentColor" stroke-width="2"/>
  <!-- Grid lines left panel -->
  <line x1="19" y1="34" x2="19" y2="50" stroke="currentColor" stroke-width="1" opacity="0.5"/>
  <line x1="8" y1="42" x2="30" y2="42" stroke="currentColor" stroke-width="1" opacity="0.5"/>
  <!-- Solar panel right -->
  <rect x="34" y="34" width="22" height="16" rx="2" fill="currentColor" opacity="0.2" stroke="currentColor" stroke-width="2"/>
  <!-- Grid lines right panel -->
  <line x1="45" y1="34" x2="45" y2="50" stroke="currentColor" stroke-width="1" opacity="0.5"/>
  <line x1="34" y1="42" x2="56" y2="42" stroke="currentColor" stroke-width="1" opacity="0.5"/>
  <!-- Shine glint left -->
  <path d="M12 37 L16 37 L13 40 Z" fill="currentColor" opacity="0.5"/>
  <!-- Shine glint right -->
  <path d="M38 37 L42 37 L39 40 Z" fill="currentColor" opacity="0.5"/>
  <!-- Legs/mount -->
  <line x1="19" y1="50" x2="17" y2="58" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="19" y1="50" x2="21" y2="58" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="45" y1="50" x2="43" y2="58" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="45" y1="50" x2="47" y2="58" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
