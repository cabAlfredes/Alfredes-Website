---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Solar panels with a happy smiling sun -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Sun -->
  <circle cx="32" cy="14" r="8" fill="currentColor" opacity="0.85"/>
  <!-- Sun rays -->
  <line x1="32" y1="3" x2="32" y2="1" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="43" y1="6" x2="45" y2="4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="48" y1="14" x2="51" y2="14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="43" y1="22" x2="45" y2="24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="21" y1="6" x2="19" y2="4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="16" y1="14" x2="13" y2="14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="21" y1="22" x2="19" y2="24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
  <!-- Sun face: eyes -->
  <circle cx="29" cy="13" r="1.3" fill="white" opacity="0.75"/>
  <circle cx="35" cy="13" r="1.3" fill="white" opacity="0.75"/>
  <!-- Sun face: smile -->
  <path d="M28 16.5 Q32 20 36 16.5" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.75"/>
  <!-- Solar panel left -->
  <rect x="8" y="34" width="22" height="16" rx="2" fill="currentColor" opacity="0.18" stroke="currentColor" stroke-width="2"/>
  <line x1="19" y1="34" x2="19" y2="50" stroke="currentColor" stroke-width="1" opacity="0.45"/>
  <line x1="8" y1="42" x2="30" y2="42" stroke="currentColor" stroke-width="1" opacity="0.45"/>
  <!-- Solar panel right -->
  <rect x="34" y="34" width="22" height="16" rx="2" fill="currentColor" opacity="0.18" stroke="currentColor" stroke-width="2"/>
  <line x1="45" y1="34" x2="45" y2="50" stroke="currentColor" stroke-width="1" opacity="0.45"/>
  <line x1="34" y1="42" x2="56" y2="42" stroke="currentColor" stroke-width="1" opacity="0.45"/>
  <!-- Mount legs -->
  <line x1="19" y1="50" x2="17" y2="58" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="19" y1="50" x2="21" y2="58" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="45" y1="50" x2="43" y2="58" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <line x1="45" y1="50" x2="47" y2="58" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  <!-- Ground line with small grass tufts -->
  <line x1="6" y1="60" x2="58" y2="60" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
  <path d="M28 60 Q27 56 28 54 Q29 56 30 54 Q31 56 32 54 Q33 56 34 54 Q35 56 36 60" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.45"/>
</svg>
