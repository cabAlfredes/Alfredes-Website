---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Folded towels and linens stack -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Shelf -->
  <rect x="6" y="54" width="52" height="4" rx="2" fill="currentColor" opacity="0.35"/>
  <!-- Bottom towel (large, rolled) -->
  <rect x="14" y="42" width="36" height="13" rx="4" fill="currentColor" opacity="0.3" stroke="currentColor" stroke-width="1.5"/>
  <!-- Stripe on bottom towel -->
  <line x1="14" y1="47" x2="50" y2="47" stroke="currentColor" stroke-width="2" opacity="0.4"/>
  <line x1="14" y1="51" x2="50" y2="51" stroke="currentColor" stroke-width="2" opacity="0.4"/>
  <!-- Middle sheet (folded flat) -->
  <rect x="10" y="30" width="44" height="13" rx="3" fill="currentColor" opacity="0.2" stroke="currentColor" stroke-width="1.5"/>
  <!-- Fold crease -->
  <line x1="10" y1="36" x2="54" y2="36" stroke="currentColor" stroke-width="1" opacity="0.5"/>
  <!-- Fold flap -->
  <path d="M10 30 Q32 27 54 30 L54 36 Q32 33 10 36 Z" fill="currentColor" opacity="0.2"/>
  <!-- Top towel (rolled, standing) -->
  <ellipse cx="32" cy="24" rx="12" ry="7" fill="currentColor" opacity="0.55" stroke="currentColor" stroke-width="1.5"/>
  <ellipse cx="32" cy="24" rx="8" ry="5" fill="currentColor" opacity="0.3"/>
  <ellipse cx="32" cy="24" rx="4" ry="3" fill="currentColor" opacity="0.5"/>
  <!-- Small hand towel leaning -->
  <rect x="46" y="16" width="10" height="16" rx="3" fill="currentColor" opacity="0.4" stroke="currentColor" stroke-width="1.5" transform="rotate(8 51 24)"/>
  <!-- Stripe on small towel -->
  <line x1="46" y1="22" x2="56" y2="22" stroke="currentColor" stroke-width="1.5" opacity="0.5" transform="rotate(8 51 22)"/>
  <!-- Decorative leaf/scent -->
  <path d="M12 18 Q8 12 14 10 Q16 16 12 18Z" fill="currentColor" opacity="0.4"/>
  <path d="M12 18 Q18 12 20 14 Q16 18 12 18Z" fill="currentColor" opacity="0.3"/>
  <line x1="12" y1="18" x2="12" y2="22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
</svg>
