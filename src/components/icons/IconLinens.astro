---
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<!-- Folded towels and linens with a fresh fern sprig -->
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Shelf -->
  <rect x="6" y="54" width="52" height="4" rx="2" fill="currentColor" opacity="0.3"/>
  <!-- Bottom towel (wide, rolled) -->
  <rect x="12" y="42" width="40" height="13" rx="4" fill="currentColor" opacity="0.25" stroke="currentColor" stroke-width="1.5"/>
  <!-- Towel stripe -->
  <line x1="12" y1="47" x2="52" y2="47" stroke="currentColor" stroke-width="2" opacity="0.35"/>
  <line x1="12" y1="51" x2="52" y2="51" stroke="currentColor" stroke-width="2" opacity="0.35"/>
  <!-- Middle sheet (flat fold) -->
  <rect x="10" y="30" width="44" height="13" rx="3" fill="currentColor" opacity="0.18" stroke="currentColor" stroke-width="1.5"/>
  <path d="M10 30 Q32 27 54 30 L54 36 Q32 33 10 36 Z" fill="currentColor" opacity="0.18"/>
  <!-- Top rolled towel -->
  <ellipse cx="28" cy="24" rx="13" ry="7" fill="currentColor" opacity="0.5" stroke="currentColor" stroke-width="1.5"/>
  <ellipse cx="28" cy="24" rx="8" ry="4.5" fill="currentColor" opacity="0.25"/>
  <ellipse cx="28" cy="24" rx="4" ry="2.5" fill="currentColor" opacity="0.45"/>
  <!-- Fern sprig (prominent, on the right) -->
  <!-- Main stem -->
  <path d="M46 54 Q46 40 48 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.7"/>
  <!-- Fern fronds left -->
  <path d="M46 50 Q40 46 38 48" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.55"/>
  <path d="M46 45 Q40 41 39 43" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.55"/>
  <path d="M47 40 Q41 36 40 38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.55"/>
  <!-- Fern fronds right -->
  <path d="M46 50 Q52 46 54 48" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.45"/>
  <path d="M47 45 Q53 41 55 43" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.45"/>
  <path d="M47 40 Q53 36 55 38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.45"/>
  <!-- Frond tips -->
  <ellipse cx="38" cy="48" rx="2" ry="1.2" fill="currentColor" opacity="0.4" transform="rotate(-20 38 48)"/>
  <ellipse cx="39" cy="43" rx="2" ry="1.2" fill="currentColor" opacity="0.4" transform="rotate(-15 39 43)"/>
  <ellipse cx="40" cy="38" rx="2" ry="1.2" fill="currentColor" opacity="0.4" transform="rotate(-10 40 38)"/>
</svg>
