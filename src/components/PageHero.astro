---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<!-- Hero Banner -->
<div class="relative h-72 md:h-96 overflow-hidden">
  <!-- Multi-layer gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-emerald-800 via-emerald-600 to-teal-500"></div>
  <div class="absolute inset-0 bg-gradient-to-tr from-amber-600/30 via-transparent to-emerald-400/20"></div>
  
  <!-- Decorative shapes -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-emerald-400/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-amber-400/20 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
  <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-teal-300/10 rounded-full blur-2xl -translate-x-1/2 -translate-y-1/2"></div>
  
  <!-- Content -->
  <div class="relative z-10 flex items-center justify-center h-full">
    <div class="text-center text-white px-4">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-4 text-shadow-lg tracking-tight">
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg md:text-xl lg:text-2xl opacity-90 font-light">
          {subtitle}
        </p>
      )}
    </div>
  </div>
  
  <!-- Bottom wave transition -->
  <div class="absolute bottom-0 left-0 w-full">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
      <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" class="fill-emerald-50/50"/>
    </svg>
  </div>
</div>

<style>
  .text-shadow-lg {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }
</style>
