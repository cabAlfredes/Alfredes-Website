---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
}

const { title, subtitle, image = "/assets/hero_xl.jpg" } = Astro.props;
---

<div class="relative h-64 sm:h-80 lg:h-96 overflow-hidden">
  <!-- Background image -->
  <div
    class="absolute inset-0 bg-cover bg-center scale-105"
    style={`background-image: url('${image}');`}
  ></div>

  <!-- Dark top vignette -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/20 to-transparent"></div>

  <!-- Green bottom fade -->
  <div class="absolute inset-0 bg-gradient-to-t from-emerald-900/70 via-emerald-900/20 to-transparent"></div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white px-4 pb-8">
    <h1 class="hero-title font-bold tracking-tight mb-2 drop-shadow-lg">{title}</h1>
    {subtitle && (
      <p class="text-base sm:text-lg lg:text-xl font-light opacity-90 drop-shadow max-w-xl">{subtitle}</p>
    )}
  </div>

  <!-- Bottom wave -->
  <div class="absolute bottom-0 left-0 w-full leading-none">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-10 sm:h-14">
      <path d="M0 80L80 72C160 64 320 48 480 44C640 40 800 48 960 54C1120 60 1280 64 1360 66L1440 68V80H0Z" fill="white"/>
    </svg>
  </div>
</div>

<style>
  .hero-title {
    font-size: clamp(1.8rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
</style>
