---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm.astro';
import { useTranslations } from '../../i18n/utils';
import IconWifi from '../icons/IconWifi.astro';
import IconSolar from '../icons/IconSolar.astro';
import IconKitchen from '../icons/IconKitchen.astro';
import IconBed from '../icons/IconBed.astro';
import IconKayak from '../icons/IconKayak.astro';
import IconBBQ from '../icons/IconBBQ.astro';
import IconDeck from '../icons/IconDeck.astro';
import IconLinens from '../icons/IconLinens.astro';

const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t('meta.servicios')}>
  <div class="min-h-screen bg-gradient-to-b from-emerald-50/50 via-white to-amber-50/30">
    <PageHero title={t('services.pageTitle')} subtitle={t('services.pageSubtitle')} />

    <div class="container mx-auto px-4 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Left Column - Services List -->
        <div>
          <div class="bg-card rounded-xl shadow-md border p-8">
            <!-- Featured highlights -->
            <div class="space-y-4 mb-8">
              <div class="flex items-center gap-4 p-4 bg-gradient-to-r from-emerald-50 to-teal-50 rounded-lg border border-emerald-200">
                <div class="flex-shrink-0 w-14 h-14 bg-emerald-500/10 rounded-xl flex items-center justify-center">
                  <IconWifi class="w-10 h-10 text-emerald-600" />
                </div>
                <span class="text-emerald-700 font-semibold text-lg">{t('services.wifi')}</span>
              </div>

              <div class="flex items-center gap-4 p-4 bg-gradient-to-r from-amber-50 to-yellow-50 rounded-lg border border-amber-200">
                <div class="flex-shrink-0 w-14 h-14 bg-amber-500/10 rounded-xl flex items-center justify-center">
                  <IconSolar class="w-10 h-10 text-amber-600" />
                </div>
                <span class="text-amber-700 font-semibold text-lg">{t('services.solar')}</span>
              </div>
            </div>

            <div class="border-t border-gray-200 my-6"></div>

            <!-- Amenities grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                <div class="svc-icon-wrap"><IconKitchen class="svc-icon" /></div>
                <span class="text-sm text-muted-foreground leading-relaxed">{t('services.kitchen')}</span>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                <div class="svc-icon-wrap"><IconBed class="svc-icon" /></div>
                <span class="text-sm text-muted-foreground leading-relaxed">{t('services.bed')}</span>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                <div class="svc-icon-wrap"><IconLinens class="svc-icon" /></div>
                <span class="text-sm text-muted-foreground leading-relaxed">{t('services.linens')}</span>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                <div class="svc-icon-wrap"><IconDeck class="svc-icon" /></div>
                <span class="text-sm text-muted-foreground leading-relaxed">{t('services.deck')}</span>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                <div class="svc-icon-wrap"><IconKayak class="svc-icon" /></div>
                <span class="text-sm text-muted-foreground leading-relaxed">{t('services.kayak')}</span>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                <div class="svc-icon-wrap"><IconBBQ class="svc-icon" /></div>
                <span class="text-sm text-muted-foreground leading-relaxed">{t('services.bbq')}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column - Contact Form -->
        <div>
          <ContactForm />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .svc-icon-wrap {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    background: color-mix(in srgb, var(--primary, #2d7a4e) 8%, transparent);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .svc-icon {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--primary, #2d7a4e);
  }
</style>
