---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Test Page">
  <div class="min-h-screen bg-red-500 flex items-center justify-center">
    <div class="bg-white p-8 rounded-lg shadow-lg">
      <h1 class="text-4xl font-bold text-blue-600 mb-4">Tailwind Test</h1>
      <p class="text-gray-700 mb-4">If you can see this styled page, Tailwind is working!</p>
      <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
        Test Button
      </button>
    </div>
  </div>
</BaseLayout>