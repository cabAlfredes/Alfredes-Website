---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

// Image data for the gallery
const exteriorImages = [
  { src: '/assets/gallery/exterior/foto_1.jpg', alt: 'Vista aérea de la cabaña desde dron', cols: 1, rows: 2 },
  { src: '/assets/gallery/exterior/foto_2.jpg', alt: 'Fachada frontal de la cabaña', cols: 1, rows: 1 },
  { src: '/assets/gallery/exterior/foto_4.jpg', alt: 'Vista panorámica desde dron', cols: 1, rows: 1 },
  { src: '/assets/gallery/exterior/foto_3.jpg', alt: 'Exterior completo de la cabaña', cols: 2, rows: 2 },
  { src: '/assets/gallery/exterior/foto_5.jpg', alt: 'Vista lateral del exterior', cols: 1, rows: 2 },
  { src: '/assets/gallery/exterior/foto_6.jpg', alt: 'Muelle y río desde la cabaña', cols: 1, rows: 1 },
  { src: '/assets/gallery/exterior/foto_7.jpg', alt: 'Raposeras y vegetación del río', cols: 1, rows: 1 },
  { src: '/assets/gallery/exterior/foto_8.jpg', alt: 'Detalle del exterior', cols: 1, rows: 1 },
  { src: '/assets/gallery/exterior/foto_9.jpg', alt: 'Río y naturaleza circundante', cols: 1, rows: 1 },
  { src: '/assets/gallery/exterior/foto_10.jpg', alt: 'Vista del río Parana', cols: 1, rows: 1 },
];

const interiorImages = [
  { src: '/assets/gallery/interior/photo_int_9.jpg', alt: 'Cama matrimonial con vista al río', cols: 2, rows: 2 },
  { src: '/assets/gallery/interior/photo_int_2.jpg', alt: 'Vista del río desde la habitación', cols: 1, rows: 1 },
  { src: '/assets/gallery/interior/photo_int_3.jpg', alt: 'Banco de madera en el interior', cols: 1, rows: 2 },
  { src: '/assets/gallery/interior/photo_int_5.jpg', alt: 'Escalera y salamandra de leña', cols: 1, rows: 1 },
  { src: '/assets/gallery/interior/photo_int_6.jpg', alt: 'Baño completo', cols: 1, rows: 1 },
  { src: '/assets/gallery/interior/photo_int_7.jpg', alt: 'Cocina equipada', cols: 1, rows: 2 },
  { src: '/assets/gallery/interior/photo_int_8.jpg', alt: 'Vista interior hacia el exterior', cols: 1, rows: 2 },
  { src: '/assets/gallery/interior/photo_int_4.jpg', alt: 'Amplia vista del exterior', cols: 1, rows: 2 },
];
---

<BaseLayout title="Cabaña Alfredes | Fotos">
  <!-- Hero Banner -->
  <div class="relative h-64 md:h-80 bg-gradient-to-r from-primary/90 to-secondary/90 overflow-hidden">
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="relative z-10 flex items-center justify-center h-full">
      <div class="text-center text-white">
        <h1 class="text-4xl md:text-6xl font-bold mb-4 text-shadow-lg">
          Galería de Imágenes
        </h1>
        <p class="text-lg md:text-xl opacity-90">
          Descubre la belleza de Cabaña Alfredes
        </p>
      </div>
    </div>
    <!-- Decorative elements -->
    <div class="absolute bottom-0 left-0 w-full h-16 bg-gradient-to-t from-white to-transparent"></div>
  </div>

  <div class="container mx-auto px-4 py-12">
    <!-- Tab Navigation -->
    <div class="flex justify-center mb-12">
      <div class="bg-white rounded-lg shadow-lg p-1 border">
        <div class="flex space-x-1">
          <button
            id="tab-interior"
            class="px-6 py-3 rounded-md font-medium transition-all duration-200 text-primary border-2 border-transparent hover:border-primary/20 active-tab"
          >
            🏠 Interior
          </button>
          <button
            id="tab-exterior"
            class="px-6 py-3 rounded-md font-medium transition-all duration-200 text-muted-foreground hover:text-primary hover:bg-primary/5"
          >
            🌿 Exterior
          </button>
        </div>
      </div>
    </div>

    <!-- Interior Gallery -->
    <div id="gallery-interior" class="gallery-section">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-primary mb-2">Espacios Interiores</h2>
        <p class="text-muted-foreground">Confort y calidez en cada rincón</p>
      </div>

      <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4 space-y-4">
        {interiorImages.map((image, index) => (
          <div class="break-inside-avoid mb-4">
            <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 cursor-pointer transform hover:-translate-y-1">
              <img
                src={image.src}
                alt={image.alt}
                class="w-full h-auto object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
                data-src={image.src}
              />

              <!-- Overlay with info -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <p class="text-white text-sm font-medium">{image.alt}</p>
                </div>
              </div>

              <!-- Click indicator -->
              <div class="absolute top-4 right-4 w-8 h-8 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                </svg>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Exterior Gallery -->
    <div id="gallery-exterior" class="gallery-section hidden">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-primary mb-2">Espacios Exteriores</h2>
        <p class="text-muted-foreground">Naturaleza y tranquilidad del Delta</p>
      </div>

      <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4 space-y-4">
        {exteriorImages.map((image, index) => (
          <div class="break-inside-avoid mb-4">
            <div class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 cursor-pointer transform hover:-translate-y-1">
              <Image
                src={image.src}
                alt={image.alt}
                class="w-full h-auto object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
                data-src={image.src}
              />

              <!-- Overlay with info -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <p class="text-white text-sm font-medium">{image.alt}</p>
                </div>
              </div>

              <!-- Click indicator -->
              <div class="absolute top-4 right-4 w-8 h-8 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                </svg>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="fixed inset-0 bg-black/90 hidden z-50 flex items-center justify-center p-4">
      <div class="relative max-w-5xl max-h-full">
        <img id="lightbox-image" src="" alt="" class="max-w-full max-h-full object-contain" />
        <button id="lightbox-close" class="absolute top-4 right-4 text-white text-2xl hover:text-gray-300 transition-colors">
          ✕
        </button>
        <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-2xl hover:text-gray-300 transition-colors">
          ‹
        </button>
        <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-2xl hover:text-gray-300 transition-colors">
          ›
        </button>
      </div>
    </div>
  </div>

  <style>
    .text-shadow-lg {
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
  </style>

  <script>
    // Tab switching functionality
    const tabInterior = document.getElementById('tab-interior');
    const tabExterior = document.getElementById('tab-exterior');
    const galleryInterior = document.getElementById('gallery-interior');
    const galleryExterior = document.getElementById('gallery-exterior');

    function switchTab(activeTab, activeGallery, inactiveTab, inactiveGallery) {
      activeTab.classList.add('active-tab');
      activeTab.classList.remove('text-muted-foreground', 'hover:bg-primary/5');
      activeTab.classList.add('text-primary', 'bg-primary/10');

      inactiveTab.classList.remove('active-tab', 'text-primary', 'bg-primary/10');
      inactiveTab.classList.add('text-muted-foreground', 'hover:bg-primary/5');

      activeGallery.classList.remove('hidden');
      inactiveGallery.classList.add('hidden');
    }

    tabInterior.addEventListener('click', () => {
      switchTab(tabInterior, galleryInterior, tabExterior, galleryExterior);
    });

    tabExterior.addEventListener('click', () => {
      switchTab(tabExterior, galleryExterior, tabInterior, galleryInterior);
    });

    // Lightbox functionality
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    let currentImages = [];
    let currentIndex = 0;

    // Add click handlers to all images
    document.querySelectorAll('.gallery-section img').forEach((img, index) => {
      img.addEventListener('click', () => {
        const gallerySection = img.closest('.gallery-section');
        currentImages = Array.from(gallerySection.querySelectorAll('img')).map(img => ({
          src: img.src,
          alt: img.alt
        }));

        currentIndex = Array.from(gallerySection.querySelectorAll('img')).indexOf(img);

        openLightbox(currentImages[currentIndex]);
      });
    });

    function openLightbox(imageData) {
      lightboxImage.src = imageData.src;
      lightboxImage.alt = imageData.alt;
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    lightboxClose.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    lightboxPrev.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
      openLightbox(currentImages[currentIndex]);
    });

    lightboxNext.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % currentImages.length;
      openLightbox(currentImages[currentIndex]);
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
        openLightbox(currentImages[currentIndex]);
      } else if (e.key === 'ArrowRight') {
        currentIndex = (currentIndex + 1) % currentImages.length;
        openLightbox(currentImages[currentIndex]);
      }
    });

    // Initialize with interior tab active
    switchTab(tabInterior, galleryInterior, tabExterior, galleryExterior);
  </script>
</BaseLayout>