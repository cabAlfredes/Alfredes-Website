---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { ContactForm } from '../components/ContactForm';
---

<BaseLayout title="Cabaña Alfredes | Servicios">
  <div class="min-h-screen bg-gradient-to-b from-emerald-50/50 via-white to-amber-50/30">
    <PageHero title="Servicios" subtitle="Todo lo que necesitas para tu estadía" />

    <div class="container mx-auto px-4 py-12">
      <!-- Two Column Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Left Column - Services List -->
      <div>
        <div class="bg-card rounded-lg shadow-sm border p-6">
          <div class="space-y-4">
            <div class="flex items-start space-x-3">
              <div class="text-green-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                </svg>
              </div>
              <span class="text-green-600 font-medium">Ahora la cabaña esta conectada a internet.</span>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-green-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <span class="text-green-600 font-medium">Tenemos Paneles solares para poder seguir teniendo luz en caso de corte.</span>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-gray-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v10c0 1.1.9 2 2 2s2-.9 2-2V6c0-1.1-.9-2-2-2s-2 .9-2 2z"/>
                </svg>
              </div>
              <span>La Cabaña cuenta con un living cocina-comedor equipada con utensilios y elementos de cocina para 2 ó 4 personas.</span>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-gray-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5h2v2h-.5c-.83 0-1.5.67-1.5 1.5S8.67 10 9.5 10H11v2H8v2h3v2H8v2h5c1.66 0 3-1.34 3-3V7c0-1.66-1.34-3-3-3H8V5z"/>
                </svg>
              </div>
              <span>Heladera y Cocina convencional con Horno.</span>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-gray-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V7H1v10h22v-6c0-2.76-2.24-5-5-5z"/>
                </svg>
              </div>
              <span>Blancos - Sabanas - Toallas</span>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-gray-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V7H1v10h22v-6c0-2.76-2.24-5-5-5z"/>
                </svg>
              </div>
              <span>Cama matrimonial con vista al rio y fondo del parque en el piso superior.</span>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-gray-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M22 9v6c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V9c0-1.1.9-2 2-2h16c1.1 0 2 .9 2 2z"/>
                </svg>
              </div>
              <span>Deck con vista al río.</span>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-gray-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20 21c-1.39 0-2.78-.47-4-1.32-.85.43-1.79.68-2.8.68-.68 0-1.33-.13-1.95-.37C8.87 20.63 7.5 21 6 21c-2.21 0-4-1.79-4-4V7c0-.55.45-1 1-1s1 .45 1 1v10c0 1.1.9 2 2 2s2-.9 2-2V7c0-.55.45-1 1-1s1 .45 1 1v10c0 1.1.9 2 2 2s2-.9 2-2V7c0-.55.45-1 1-1s1 .45 1 1v10c0 1.1.9 2 2 2s2-.9 2-2V7c0-.55.45-1 1-1s1 .45 1 1v10c0 2.21-1.79 4-4 4z"/>
                </svg>
              </div>
              <span>Una piragua a disposición para remar.</span>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-gray-500 mt-1">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17 5.33C17 4.6 16.4 4 15.67 4H14V2h-4v2H8.33C7.6 4 7 4.6 7 5.33V15c0 .74.6 1.34 1.33 1.34h9.33c.74 0 1.34-.6 1.34-1.34V5.33z"/>
                </svg>
              </div>
              <span>Parrilla y mesa en el jardín.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Contact Form -->
      <div>
        <ContactForm client:load />
      </div>
      </div>
    </div>
  </div>
</BaseLayout>