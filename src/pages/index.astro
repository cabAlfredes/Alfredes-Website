---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout title="Cabaña Alfredes">
	<div>
		<!-- Full-page Video Hero Section -->
		<div class="relative h-screen w-full overflow-hidden">
			<!-- Video Background (source added via JS) -->
			<video
				id="hero-video"
				muted
				loop
				poster="/assets/hero_xl.jpg"
				preload="none"
				class="absolute inset-0 w-full h-full object-cover"
				data-src="/assets/hero-video.mp4"
			>
			</video>

			<!-- Dark overlay -->

			<div
				id="hero-overlay"
				class="absolute inset-0 bg-linear-to-r from-black/70 via-black/50 to-black/30 transition-opacity duration-500"
			>
				<!-- Hero Content - Left aligned like Beyonk -->
				<div
					id="hero-content"
					class="relative z-10 container mx-auto px-6 md:px-12 min-h-screen flex items-center transition-opacity duration-500"
				>
					<div class="max-w-2xl text-white">
						<h1
							class="text-5xl md:text-6xl lg:text-7xl font-bold italic mb-6 text-shadow-lg tracking-tight leading-tight"
						>
							Cabaña Alfredes.
						</h1>
						<p
							class="text-lg md:text-xl font-light mb-10 text-white/85 text-shadow-sm"
						>
							Tu refugio en el Delta del Paraná. Naturaleza, río y tranquilidad.
						</p>

						<!-- CTA Buttons -->
						<div class="flex flex-wrap items-center gap-4">
							<a
								href="/contacto"
								class="px-8 py-3.5 bg-emerald-800 hover:bg-emerald-600 text-white font-semibold rounded-lg transition-colors text-lg"
							>
								Reservá tu estadía
							</a>
							<!-- <button
								id="hero-play-btn"
								class="flex items-center gap-3 px-6 py-3.5 border-2 border-white/50 hover:border-white rounded-lg transition-colors group"
							>
								<span
									class="w-10 h-10 rounded-full bg-white/20 group-hover:bg-white/30 flex items-center justify-center transition-colors"
								>
									<svg
										class="w-5 h-5 text-white ml-0.5"
										fill="currentColor"
										viewBox="0 0 24 24"
									>
										<path d="M8 5v14l11-7z"></path>
									</svg>
								</span>
								<span class="text-white font-medium text-lg">Ver video</span>
							</button> -->
						</div>
					</div>
				</div>
			</div>
			<div class="absolute top-1 right-1 z-50 flex gap-2">
				<div
					id="pause"
					class="bg-slate-500 cursor-pointer text-white px-3 py-1 rounded-md text-sm hidden"
					role="button"
				>
					pause
				</div>
				<div
					id="play"
					class="bg-slate-500 cursor-pointer text-white px-3 py-1 rounded-md text-sm"
					role="button"
				>
					play
				</div>
			</div>
		</div>

		<script>
			const video = document.getElementById("hero-video") as HTMLVideoElement;
			// const playBtn = document.getElementById("hero-play-btn")!;
			const pauseBtn = document.getElementById("pause")!;
			const playBtn = document.getElementById("play")!;
			const heroContent = document.getElementById("hero-content")!;
			const heroOverlay = document.getElementById("hero-overlay")!;
			const videoSrc = video.dataset.src!;
			let videoLoaded = false;
			const isMobile = window.matchMedia("(max-width: 767px)");

			function loadVideo(): Promise<void> {
				if (videoLoaded) return Promise.resolve();
				videoLoaded = true;
				// Fetch once as blob so looping never re-downloads
				return fetch(videoSrc)
					.then((res) => res.blob())
					.then((blob) => {
						video.src = URL.createObjectURL(blob);
					});
			}

			function hideHeroContent() {
				heroContent.style.opacity = "0";
				heroContent.style.pointerEvents = "none";
				heroOverlay.style.opacity = "0";
				// pauseBtn.classList.remove("hidden");
			}

			function showHeroContent() {
				heroContent.style.opacity = "1";
				heroContent.style.pointerEvents = "";
				heroOverlay.style.opacity = "1";
				// pauseBtn.classList.add("hidden");
			}

			// Desktop: silently autoplay muted in background
			if (!isMobile.matches) {
				loadVideo().then(() => {
					video.controls = true;
					video.play().catch(() => {});
				});
			}

			// "Ver video" button: load (if needed), hide text, play with controls
			playBtn.addEventListener("click", () => {
				if (isMobile.matches) {
					hideHeroContent();
				}
				loadVideo().then(() => {
					video.muted = true;
					video.controls = true;
					video.play().catch(() => {});
				});
			});

			// "pause" button: pause video, show hero content again
			pauseBtn.addEventListener("click", () => {
				video.pause();
				pauseBtn.classList.add("hidden");
				if (isMobile.matches) {
					showHeroContent();
				}
			});

			video.addEventListener("playing", () => {
				console.log("Video playing");
				pauseBtn.classList.remove("hidden");
				playBtn.classList.add("hidden");

				if (isMobile.matches) {
					hideHeroContent();
				}
			});

			video.addEventListener("pause", () => {
				console.log("Video paused");
				pauseBtn.classList.add("hidden");
				playBtn.classList.remove("hidden");
				showHeroContent();
			});

			// If user pauses via controls, show hero content again
			video.addEventListener("pause", () => {
				if (video.controls) {
					showHeroContent();
					video.controls = false;
					video.muted = true;
				}
			});
		</script>

		<style>
			.text-shadow-lg {
				text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.7);
			}
			.text-shadow-md {
				text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);
			}
			.text-shadow-sm {
				text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
			}
		</style>
	</div>
</BaseLayout>
